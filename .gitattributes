# 统一换行
* text=auto

# Unity 文本资产：保留可读 diff，不进 LFS
*.cs         text diff=csharp
*.shader     text
*.compute    text
*.hlsl       text
*.cginc      text
*.unity      text
*.prefab     text
*.asset      text
*.mat        text
*.anim       text
*.controller text
*.inputactions text
*.asmdef     text
*.json       text
*.md         text
*.csv        text
*.meta       text
*.mask       text
*.txt        text
*.xml        text
*.config     text
*.gitignore  text
*.vsconfig   text
# 真正的二进制 / 大资产 -> Git LFS
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.dae   filter=lfs diff=lfs merge=lfs -text
